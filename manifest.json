{
  "manifest_version": 3,
  "name": "Auto Tab Memory Saver",
  "version": "0.1.0",
  "description": "Automatically discards inactive tabs with native Chrome tab discarding.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "idle",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Tab Memory Saver",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "discard-inactive-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Discard inactive tabs in the current window"
    },
    "reload-discarded-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Reload discarded tabs in the current window"
    }
  }
}
